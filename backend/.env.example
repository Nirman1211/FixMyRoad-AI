# ========================================================
# FixMyRoad AI - Backend Configuration (.env)
# ========================================================

# Application Settings
PROJECT_NAME="FixMyRoad AI"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# Security & Secrets (Generate with: openssl rand -hex 32)
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite (Local zero-config development):
DATABASE_URL="sqlite:///./fixmyroad.db"
# PostgreSQL + PostGIS (Production / Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fixmyroad_db"

# Computer Vision & Machine Learning
USE_LOCAL_YOLO=true
YOLO_MODEL_PATH="models/yolov8n.pt"
CONFIDENCE_THRESHOLD=0.40

# Roboflow Fallback (Optional)
# If left empty, local CV engine operates 100% offline
ROBOFLOW_API_KEY=""
ROBOFLOW_PROJECT="pothole-detection-i00zy"
ROBOFLOW_VERSION=2

# CORS Allowed Origins (Comma-separated or list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
